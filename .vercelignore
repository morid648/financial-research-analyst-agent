# Hide the full root requirements.txt (~6.3 GB installed) so Vercel installs
# the slim dependency set from pyproject.toml (500 MB function limit).
/requirements.txt

# Not needed at runtime. Leading "/" anchors each rule to the repo root —
# an unanchored "data/" also matched src/data/ and broke the app import.
/.venv/
/.agent/
/.claude/
/tests/
/notebooks/
/docs/
/postman/
/logs/
/data/
